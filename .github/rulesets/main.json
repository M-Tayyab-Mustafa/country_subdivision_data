{
  "name": "Protected main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Formatting"
          },
          {
            "context": "Static analysis"
          },
          {
            "context": "Unit and integration tests"
          },
          {
            "context": "Snapshot validation"
          },
          {
            "context": "Nigeria regression validation"
          },
          {
            "context": "Deterministic-generation validation"
          },
          {
            "context": "Flutter SDK verification"
          },
          {
            "context": "Upstream metadata verification"
          },
          {
            "context": "Version-policy verification"
          },
          {
            "context": "Release-review verification"
          },
          {
            "context": "pub.dev publication dry-run"
          }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "check_response_timeout_minutes": 60,
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 5,
        "max_entries_to_merge": 1,
        "merge_method": "SQUASH",
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 0
      }
    }
  ]
}
